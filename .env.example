# Root env for docker compose. Copy to .env and fill in; never commit .env.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=nasa_space_app
POSTGRES_PORT=5432
REDIS_PORT=6379
BACKEND_PORT=8000
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Host folder with fieldshift-data-kit/data/processed (mounted read-only into the backend)
PROCESSED_HOST_DIR=../fieldshift-data-kit/data/processed
