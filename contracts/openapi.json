          },
          "hasDailyPrecipitation": {
            "type": "boolean",
            "title": "Hasdailyprecipitation"
          },
          "overallConfidence": {
            "type": "string",
            "enum": [
              "HIGH",
              "MODERATE",
              "LOW"
            ],
            "title": "Overallconfidence"
          },
          "missingDataNotes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missingdatanotes"
          }
        },
        "type": "object",
        "required": [
          "hasObservedRotation",
          "hasFieldSoilSurvey",
          "hasSatelliteNdvi",
          "hasDailyPrecipitation",
          "overallConfidence",
          "missingDataNotes"
        ],
        "title": "DataAvailability"
      },
      "ErrorInfo": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Stable machine-readable error code"
          },
          "message": {
            "type": "string",
            "title": "Message",
            "description": "Human-readable message, safe to show to users"
          },
          "details": {
            "anyOf": [
              {
                "items": {
