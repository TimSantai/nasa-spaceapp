        "type": "object",
        "required": [
          "site",
          "analogs",
          "weights",
          "risk_aversion",
          "strategies",
          "scenario",
          "disclaimer"
        ],
        "title": "ComparisonOut"
      },
      "DataAvailability": {
        "properties": {
          "hasObservedRotation": {
            "type": "boolean",
