      "ClimateMonth": {
        "properties": {
          "month": {
            "type": "string",
            "title": "Month"
          },
          "rainfall": {
            "type": "number",
            "title": "Rainfall",
            "description": "Mean monthly rainfall 1991-2020, mm"
          },
          "tempMin": {
            "type": "number",
            "title": "Tempmin"
          },
          "tempMax": {
            "type": "number",
            "title": "Tempmax"
          },
          "soilMoisture": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Soilmoisture",
            "description": "Root-zone soil wetness, 0-1"
          }
        },
        "type": "object",
        "required": [
          "month",
          "rainfall",
          "tempMin",
          "tempMax",
          "soilMoisture"
        ],
        "title": "ClimateMonth"
      },
      "CompareRequest": {
        "properties": {
          "site": {
            "type": "string",
            "pattern": "^[a-z0-9_]{1,40}$",
            "title": "Site",
            "examples": [
              "nevada_mason_valley"
            ]
          },
          "priorities": {
            "$ref": "#/components/schemas/Priorities"
          },
          "risk_aversion": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Risk Aversion",
            "description": "0 = average years only, 1 = worst 20 % only",
            "default": 0.5
          },
          "enso_phase": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "el_nino",
                  "la_nina",
                  "neutral"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Enso Phase",
            "description": "Default: latest observed"
          },
          "iod_phase": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "positive",
                  "negative",
                  "neutral"
                ]
              },
              {
                "type": "null"
              }
            ],
            "title": "Iod Phase",
            "description": "Default: latest observed"
          },
          "field_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[a-z0-9_-]{1,64}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Field Id",
            "description": "Use this field's slope and soil water capacity (from /api/v1/fields)"
          },
          "scenario": {
            "$ref": "#/components/schemas/ScenarioIn"
          },
          "baseline": {
            "anyOf": [
              {
                "items": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "type": "object"
                },
                "type": "array",
                "maxItems": 10,
                "minItems": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Baseline",
            "description": "Farmer's current rotation: one {season: crop} object per year; seasons left out are fallow. Replaces the default baseline."
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "site"
        ],
        "title": "CompareRequest"
      },
      "ComparisonOut": {
        "properties": {
          "site": {
            "type": "string",
            "title": "Site"
          },
          "analogs": {
            "$ref": "#/components/schemas/AnalogsOut"
          },
          "weights": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Weights"
